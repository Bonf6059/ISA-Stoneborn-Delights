<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="ISA_AlchemyMushBase">
		<defName>ISA_ArtokMush</defName>
		<label>artok mush</label>
		<graphicData>
			<texPath>Textures/Things/Items/Drugs/Wort/WortArtok</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
	</ThingDef>

<!-- =============== Artok =============== -->
	
	<ThingDef ParentName="MedicineBase">
		<defName>ISA_Artok</defName>
		<label>artok</label>
		<description>Also known as the "Artisans dream". It increases muscular activity and reduces fatigue, giving a small mood boost. Some people swear this drug inspired them to make great creations.</description>
		<possessionCount>10</possessionCount>
		<descriptionHyperlinks><HediffDef>ISA_High_Artok</HediffDef></descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Items/Drugs/Artok</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<socialPropernessMatters>false</socialPropernessMatters>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>520</MarketValue> <!-- (Mixture Market value / cauldron drop ammount) + 20-->
			<Mass>0.5</Mass>
			<Flammability>0.1</Flammability>
		</statBases>
		<techLevel>Medieval</techLevel>
		<ingestible>
    		<foodType>Processed</foodType>
			<nurseable>true</nurseable>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.21,0,0.05)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestHoldUsesTable>false</ingestHoldUsesTable>
			<ingestCommandString>Drink {0}</ingestCommandString>
			<ingestReportString>Drinking {0}.</ingestReportString>
			<preferability>NeverForNutrition</preferability>
			<drugCategory>Medical</drugCategory>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
				<hediffDef>ISA_High_Artok</hediffDef>
				<severity>1.0</severity>
				</li>
			</outcomeDoers>
		</ingestible>
		
		<comps>
		<li Class="CompProperties_Drug">
			<listOrder>1000</listOrder>
			<overdoseSeverityOffset>0.08~0.14</overdoseSeverityOffset>
		</li>
		</comps>
	</ThingDef>
  
  <HediffDef>
    <defName>ISA_High_Artok</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>artok</label>
    <description>A temporary state of increased muscles activity and lowered fatigue.</description>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2</severityPerDay>		<!-- 24h / severityPerDay = how many hours it lasts -->
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
      <stages>
        <li>
			    
          <statFactors>
				    <RestFallRateFactor>0.85</RestFallRateFactor>
			    </statFactors>
			    
			    <!--<painFactor>0.66</painFactor>-->
          
			    <statOffsets>
				    <GlobalWorkSpeed>0.25</GlobalWorkSpeed>
			    </statOffsets>
          
			    <capMods>
				    <li>
					    <capacity>Consciousness</capacity>
					    <offset>0.10</offset>
				    </li>
        	</capMods>
        
        </li>
      </stages>
  </HediffDef>

	<ThoughtDef>
		<defName>ISA_Thought_Artok</defName>
		<workerClass>ThoughtWorker_Hediff</workerClass>
		<hediff>ISA_High_Artok</hediff>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<stages>
		<li>
			<label>drank artok</label>
			<description>I feel so inspired, I have so many ideas! I can't wait to make something!</description>
			<baseMoodEffect>2</baseMoodEffect>
		</li>
		</stages>
	</ThoughtDef>
  
</Defs>
