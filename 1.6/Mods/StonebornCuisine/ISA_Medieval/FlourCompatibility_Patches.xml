<?xml version="1.0" encoding="utf-8" ?>
<Patch>  

<!-- Flour name and description -->

  <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SC_Flour"]/label</xpath>
		<value>
      		<label>flour</label>
		</value>
	</Operation>
	
  <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SC_Flour"]/description</xpath>
		<value>
      		<description>Powdery and dense flour. Used for baking recipes.</description>
		</value>
	</Operation>

<!-- Bread -->
  
  <Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_MakeBread"]/ingredients/li[1]/filter</xpath>
		<value>
      		<filter>
				<categories>
          			<li>SC_FlourRaw</li>
        		</categories>
      		</filter>
		</value>
	</Operation>

  <Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_MakeBread"]/fixedIngredientFilter</xpath>
		<value>
      		<fixedIngredientFilter>
			  	<categories>
          			<li>SC_FlourRaw</li>
        		</categories>
      		</fixedIngredientFilter>
		</value>
	</Operation>

