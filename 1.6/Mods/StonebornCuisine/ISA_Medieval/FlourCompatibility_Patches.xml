		<value>
      		<fixedIngredientFilter>
				<categories>
          			<li>SC_FlourRaw</li>
        		</categories>
        		<thingDefs>
					<li>RawBerries</li>
			  	</thingDefs>
      		</fixedIngredientFilter>
		</value>
	</Operation>

