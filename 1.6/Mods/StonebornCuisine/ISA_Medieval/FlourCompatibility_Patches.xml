<?xml version="1.0" encoding="utf-8" ?>
<Patch>  

<!-- Flour -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="ISA_Flour"]/thingCategories</xpath>
		<value>
			<li>SC_FlourRaw</li>
		</value>
	</Operation>

<!-- Bread -->
  
  <Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_MakeBread"]/ingredients/li[1]/filter</xpath>
		<value>
      <filter>
			  <categories>
          <li>SC_FlourRaw</li>
        </categories>
      </filter>
		</value>
	</Operation>

  <Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_MakeBread"]/fixedIngredientFilter</xpath>
		<value>
      <fixedIngredientFilter>
			  <categories>
          <li>SC_FlourRaw</li>
        </categories>
      </fixedIngredientFilter>
		</value>
	</Operation>

  <!-- Berry Pie -->
  
