          <li>SC_FlourRaw</li>
        </categories>
      </filter>
		</value>
	</Operation>

  <Operation Class="PatchOperationReplace">
		<xpath>Defs/RecipeDef[defName="ISA_MakeBerryPie"]/fixedIngredientFilter</xpath>
		<value>
      <fixedIngredientFilter>
			  <categories>
          <li>SC_FlourRaw</li>
        </categories>
        <thingDefs>
				  <li>RawBerries</li>
			  </thingDefs>
      </fixedIngredientFilter>
		</value>
	</Operation>

