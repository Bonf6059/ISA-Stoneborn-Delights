<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- =============== Alchemy Bench =============== -->
	
<!-- Trevin Pill -->

	<RecipeDef ParentName="ISA_Make_DrugAlchemy">
		<defName>ISA_Make_TrevinPill</defName>
		<label>make trevin pill</label>
		<description>Make trevin pill.</description>
		<jobString>Making trevin pill.</jobString>
		<workAmount>470</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_Criopyrinth</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>SC_DwarvenMilk</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ISA_RawHerb</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ISA_Criopyrinth</li>
				<li>SC_DwarvenMilk</li>
				<li>ISA_RawHerb</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>ISA_Criopyrinth</li>
				<li>SC_DwarvenMilk</li>
				<li>ISA_RawHerb</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<ISA_TrevinPill>5</ISA_TrevinPill>
		</products>
	</RecipeDef>

